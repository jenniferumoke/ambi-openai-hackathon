  "narrative": {
    "northStar": "A voice-first companion whose actions stay visible",
    "overview": "This phrase comes from the current direction contract. It describes an extension of the incumbent Ambi interface, not a newly selected visual world. The organic Rive mascot, saved accent, background, scale and motion choices remain the identity. The user's requested larger mascot, stronger activity tint and clearer voice hierarchy are the durable changes recorded here.\n\nThe companion uses plain surfaces, short state language and direct controls. Its mascot is expressive, while readable state text and task details explain what is happening. Typing and action details expand when needed; this companion composition is not a universal layout rule for unrelated products.",
    "keyCharacteristics": [
      "Existing organic Rive character and saved personal appearance.",
      "Clear voice state with a single primary conversation control.",
      "Readable action history and explicit permission and stop controls.",
      "Accent feedback at active or preview edges, with a transparent screen centre."
    ],
    "rules": [
      {
        "name": "The Selected Accent Rule",
        "body": "Use the saved accent for character treatment and activity feedback. Preserve the user's background and appearance choices.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** retain the existing Rive character and saved appearance choices.",
      "**Do** keep the primary conversation action, readable state and Stop easy to find.",
      "**Do** preserve reduced-motion and Still behavior for character and activity feedback.",
      "**Do** distinguish preview, permission, running and completed states in readable text."
    ],
    "donts": [
      "**Don't** infer action success or microphone permission from motion or glow.",
      "**Don't** treat a screenshot's nontransparent mascot bounds as a fixed canvas-size token.",
      "**Don't** replace optional typing with an always-present composer on the resting companion surface."
    ]
  }
}
