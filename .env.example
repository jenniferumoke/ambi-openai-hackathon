OPENAI_API_KEY=

# Defaults verified against the OpenAI documentation on 2026-10-29.
REALTIME_MODEL=gpt-realtime-2.1
COMPUTER_MODEL=gpt-6.1-terra
VOICE=marin
VAD_THRESHOLD=0.75
ECHO_GATE_RMS=250
MAX_TURNS=30
TASK_TIMEOUT_SECONDS=180

# Camera is off unless --observe or --observe-only is explicitly passed.
# Sampled images go to OpenAI. No frames or recordings are saved locally.
DECISIONS_MODEL=gpt-6-luna
OBSERVE_INTERVAL_SECONDS=2
OBSERVE_PROBABILITY_THRESHOLD=0.8
OBSERVE_TTL_SECONDS=10
OBSERVE_COOLDOWN_SECONDS=60
OBSERVE_REQUEST_TIMEOUT_SECONDS=8

# Screen observation is off unless --observe-computer or --observe-computer-only is passed.
SCREEN_OBSERVER_MODEL=gpt-6.1-terra
SCREEN_OBSERVE_INTERVAL_SECONDS=5
SCREEN_OBSERVE_TTL_SECONDS=20
SCREEN_OBSERVE_REQUEST_TIMEOUT_SECONDS=15

# Proactive voice offers are off unless --proactive is also passed.
# Enable both sources with: uv run python main.py --observe --observe-computer --proactive
# Offers use filtered camera state; the camera settings above stay unchanged.
