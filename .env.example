OPENAI_API_KEY=

# Optional: comma-separated exact origins for another local frontend, such as
# AMBI_FRONTEND_ORIGINS=http://localhost:3000
AMBI_FRONTEND_ORIGINS=

# Defaults verified against the OpenAI documentation on 2026-11-01.
REALTIME_MODEL=gpt-realtime-2.1
COMPUTER_MODEL=gpt-6.1-terra
VOICE=marin
VAD_THRESHOLD=0.75
ECHO_GATE_RMS=250
MAX_TURNS=30
TASK_TIMEOUT_SECONDS=180

# UI: Decisions routes local numeric camera cues and task context.
DECISIONS_MODEL=gpt-6-luna

# Legacy CLI only: --observe / --observe-only sends sampled camera images.
# These settings do not control the fast local browser camera worker.
OBSERVE_INTERVAL_SECONDS=2
OBSERVE_PROBABILITY_THRESHOLD=0.8
OBSERVE_TTL_SECONDS=10
OBSERVE_COOLDOWN_SECONDS=60
OBSERVE_REQUEST_TIMEOUT_SECONDS=8

# UI: Include screen context checkbox, subject to macOS permission.
# Legacy CLI: --observe-computer or --observe-computer-only.
SCREEN_OBSERVER_MODEL=gpt-6.1-terra
SCREEN_OBSERVE_INTERVAL_SECONDS=2
SCREEN_OBSERVE_TTL_SECONDS=20
SCREEN_OBSERVE_REQUEST_TIMEOUT_SECONDS=15

# UI: proactive offers are on during a session unless Focus mode is on.
# Legacy CLI: uv run python main.py --observe --observe-computer --proactive

# Reviewed desktop-goal budgets (fresh checks before continuation)
GOAL_REVIEW_ROUNDS=6
GOAL_TIMEOUT_SECONDS=900
